# Local secrets and environment overrides
# Patterns are bracketed for case-robustness: on a case-sensitive checkout
# (core.ignorecase=false) a plain lowercase pattern would leave
# appsettings.Local.json / Secrets.json / .ENV trackable.
appsettings.*.[Ll]ocal.json
appsettings.[Ll]ocal.json
*.[Ll]ocal.json
[Ss]ecrets.json
[Aa]pp[Ss]ettings.[Ss]ecrets.json
.[Ee][Nn][Vv]
.[Ee][Nn][Vv].*

# Launch profiles: the canonical accidental-API-key leak vector. Keep the file
# locally (the templates need it); it just never gets tracked. Real secrets belong
# in user-secrets (see UserSecretsId in Cbix.Worker.csproj) or the environment.
**/Properties/launchSettings.json

# Cryptographic material - never tracked
*.pfx
*.p12
*.pem
*.key
*.crt
*.cer
*.der
*.snk
*.jks
*.keystore
id_rsa
id_dsa
id_ecdsa
id_ed25519

# NuGet lock files ARE tracked on purpose (RestorePackagesWithLockFile=true in
# Directory.Build.props). Do not add packages.lock.json to this file.

# OS noise
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
