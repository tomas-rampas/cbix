<Project>

  <!--
    Solution-wide build settings for CBIX.
    The target framework is declared here once; individual .csproj files must not
    redeclare TargetFramework, Nullable or ImplicitUsings.
    LangVersion is intentionally absent: net10.0 pins C# 14 deterministically.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisModeSecurity>All</AnalysisModeSecurity>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!--
    Apply the repo-root .runsettings to every test project so a plain `dotnet test`
    gets it with no settings flag on the command line. Its main job is disabling Azure
    Application Insights telemetry (no-Azure hard constraint); see the comment in
    .runsettings for why this covers the TEST-RUN path only, and why build-time
    telemetry additionally needs a real environment variable from CI (S01-03) and
    from developer setup.
  -->
  <PropertyGroup>
    <RunSettingsFilePath>$(MSBuildThisFileDirectory).runsettings</RunSettingsFilePath>
  </PropertyGroup>

</Project>
