<Project Sdk="Microsoft.NET.Sdk">

  <!-- Solution-wide settings come from /Directory.Build.props.
       Shared test-stack packages, GenerateDocumentationFile=false and
       ReqnrollUseIntermediateOutputPathForCodeBehind come from
       /tests/Directory.Build.props. Package versions come from
       /Directory.Packages.props (CPM). -->
  <PropertyGroup>
    <RootNamespace>Cbix.Bdd</RootNamespace>
    <AssemblyName>Cbix.Bdd</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the BDD project needs Reqnroll. -->
    <PackageReference Include="Reqnroll.xUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cbix.Core\Cbix.Core.csproj" />
  </ItemGroup>

</Project>
