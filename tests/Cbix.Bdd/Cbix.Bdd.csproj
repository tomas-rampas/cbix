<Project Sdk="Microsoft.NET.Sdk">

  <!-- Solution-wide settings come from /Directory.Build.props.
       Shared test-stack packages, test-only overrides and
       ReqnrollUseIntermediateOutputPathForCodeBehind come from
       /tests/Directory.Build.props. Package versions come from
       /Directory.Packages.props (CPM). -->
  <PropertyGroup>
    <RootNamespace>Cbix.Bdd</RootNamespace>
    <AssemblyName>Cbix.Bdd</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the BDD project needs Reqnroll. -->
    <PackageReference Include="Reqnroll.xUnit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The provider-free stub and the composition that puts it behind the triage agent
         (story S01-09). It is a separate assembly on purpose: the run executes the stub, so the
         stub's assembly is part of the dependency graph the agnosticism scenario walks, and this
         project takes a PROJECT reference to the Anthropic adapter one line further down. That
         reference emits no entry in this assembly's reference table today - the S01-08 bindings
         resolve adapter types reflectively - so the separation is not a workaround for a leak that
         exists, it is what keeps the stub's neutrality structural instead of contingent on how some
         other scenario happens to be written. See the feature file's header and
         Cbix.Agnosticism.csproj for the full reasoning. -->
    <ProjectReference Include="..\Cbix.Agnosticism\Cbix.Agnosticism.csproj" />
    <ProjectReference Include="..\..\src\Cbix.Core\Cbix.Core.csproj" />
    <!-- Referenced so the S01-08 containment scenario can reflect over what the compiler
         actually emitted into the host's reference table. Worker is the composition host:
         it may legitimately reference the provider adapter PROJECT, but must never name an
         Anthropic TYPE - and only its own assembly metadata can settle that. -->
    <ProjectReference Include="..\..\src\Cbix.Worker\Cbix.Worker.csproj" />
    <!-- The adapter under test in S01-08. Referenced so the scenario can load it and so the
         guard-the-guard step can prove the containment assertion is not vacuous. The bindings
         still resolve every adapter type by reflection: a compile-time reference here would
         make a missing adapter a build break rather than the failing assertion BDD requires. -->
    <ProjectReference Include="..\..\src\Cbix.Providers.Anthropic\Cbix.Providers.Anthropic.csproj" />
  </ItemGroup>

</Project>
