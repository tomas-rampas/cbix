<Project Sdk="Microsoft.NET.Sdk">

  <!-- Solution-wide settings come from /Directory.Build.props.
       Shared test-stack packages and test-only overrides come from
       /tests/Directory.Build.props. Package versions come from
       /Directory.Packages.props (CPM). -->
  <PropertyGroup>
    <RootNamespace>Cbix.UnitTests</RootNamespace>
    <AssemblyName>Cbix.UnitTests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the unit-test project needs runtime-conditional skips: its containment probes create
         symbolic and hard links, which some hosts refuse on privilege grounds. Cbix.Bdd already
         resolves this package transitively through Reqnroll.xUnit. -->
    <PackageReference Include="Xunit.SkippableFact" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cbix.Core\Cbix.Core.csproj" />
  </ItemGroup>

</Project>
