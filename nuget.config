<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Pin the restore sources for CBIX. <clear /> discards any machine- or user-level
    feed so a developer box and CI resolve packages identically, and the source
    mapping below makes nuget.org the only feed any package id may come from
    (defence against dependency-confusion substitution).
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
