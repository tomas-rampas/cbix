    {
      "country_iso": "DE",
      "doc_ref": "CBTI-DE-2026-011",
      "condition_ref": 2,
      "text": "Elective professional clients require a completed opt-up assessment under Sec. 67(6) WpHG and enhanced appropriateness records before the first transaction."
    },
    {
      "country_iso": "DE",
      "doc_ref": "CBTI-DE-2026-011",
      "condition_ref": 3,
      "text": "EMIR applies: LEI, ISDA Master Agreement and, for uncleared trades, CSA / initial margin documentation must be in place; German FC / NFC+ counterparties are subject to clearing and reporting obligations."
    },
    {
      "country_iso": "DE",
      "doc_ref": "CBTI-DE-2026-011",
      "condition_ref": 4,
      "text": "A PRIIPs KID must be available before distribution; a German-language KID is required for any offer capable of reaching retail investors."
    },
    {
      "country_iso": "DE",
      "doc_ref": "CBTI-DE-2026-011",
      "condition_ref": 5,
      "text": "AIF marketing only under Art. 42 AIFMD national private placement following notification to BaFin; UCITS require a completed marketing passport notification."
    },
    {
      "country_iso": "CH",
      "doc_ref": "CBTI-CH-2026-008",
      "condition_ref": 1,
      "text": "Client advisers servicing Swiss professional clients must be entered in a Swiss client adviser register unless exempt under FinSA Art. 28 as employees of a prudentially supervised foreign institution serving professional / institutional clients only."
    },
    {
      "country_iso": "CH",
      "doc_ref": "CBTI-CH-2026-008",
      "condition_ref": 2,
      "text": "FMIA obligations apply: reporting to a Swiss trade repository and, where applicable, clearing; ISDA or Swiss Master Agreement required."
    },
    {
      "country_iso": "CH",
      "doc_ref": "CBTI-CH-2026-008",
      "condition_ref": 3,
      "text": "Structured products may be offered to professional clients under FinSA Art. 36 prospectus exemptions; retail distribution would require a FinSA prospectus and KID and is not approved."
    },
    {
      "country_iso": "CH",
      "doc_ref": "CBTI-CH-2026-008",
      "condition_ref": 4,
      "text": "Collective investment schemes restricted to qualified investors under CISA Art. 10; a Swiss representative and paying agent are required for distribution to non-institutional qualified investors."
    },
    {
      "country_iso": "CH",
      "doc_ref": "CBTI-CH-2026-008",
      "condition_ref": 5,
      "text": "Cross-border advice only on a documented reverse-enquiry basis or where condition (1) is satisfied; affiliation with a recognised Swiss ombudsman (FinSA Art. 74) has been confirmed for Contoso Bank PLC."
    }
  ],
  "marketing_rules": [
    {
      "country_iso": "DE",
      "doc_ref": "CBTI-DE-2026-011",
      "seq": 1,
      "rule": "No cold calling of prospective clients (Sec. 7 UWG); contact requires prior consent or an existing relationship."
    },
    {
      "country_iso": "DE",
      "doc_ref": "CBTI-DE-2026-011",
      "seq": 2,
      "rule": "In-country visits by Contoso Bank PLC (London) staff are limited to institutional prospects and must be logged in the Cross-Border Travel Tool before travel."
    },
    {
      "country_iso": "DE",
      "doc_ref": "CBTI-DE-2026-011",
      "seq": 3,
      "rule": "Client-facing meetings with EEA retail or elective professional clients must be led by Contoso Bank Europe PLC, Frankfurt."
    },
    {
      "country_iso": "DE",
      "doc_ref": "CBTI-DE-2026-011",
      "seq": 4,
      "rule": "Marketing materials must carry approved disclaimer LEG-DE-DISC-04 and may not be addressed to retail investors."
    },
    {
      "country_iso": "DE",
      "doc_ref": "CBTI-DE-2026-011",
      "seq": 5,
      "rule": "Events and roadshows in Germany require Legal sign-off at least 10 business days in advance."
    },
    {
      "country_iso": "CH",
      "doc_ref": "CBTI-CH-2026-008",
      "seq": 1,
      "rule": "In-country travel is permitted for institutional and professional prospects; advisers must satisfy condition (1) before any client-facing activity."
    },
    {
      "country_iso": "CH",
      "doc_ref": "CBTI-CH-2026-008",
      "seq": 2,
      "rule": "All financial promotions must state the ombudsman affiliation and carry approved disclaimer LEG-CH-DISC-02."
    },
    {
      "country_iso": "CH",
      "doc_ref": "CBTI-CH-2026-008",
      "seq": 3,
      "rule": "No public advertising of financial instruments to retail (private) clients; materials must state their professional / institutional-only scope."
    },
    {
      "country_iso": "CH",
      "doc_ref": "CBTI-CH-2026-008",
      "seq": 4,
      "rule": "Third-party introducers require a written finder agreement approved by Legal & Compliance."
    }
  ],
