  "country_documents": [
    {
      "country": "Federal Republic of Germany",
      "iso": "DE",
      "doc_ref": "CBTI-DE-2026-011",
      "version": "3.2",
      "status": "Approved",
      "effective_date": "2026-08-16",
      "review_date": "2027-08-15",
      "supersedes": "CBTI-DE-2023-007 (v3.1)",
      "owner": "Legal - Cross-Border Trading Office, EMEA",
      "key_legislation": "KWG (Banking Act); WpHG (Securities Trading Act); WpIG (Investment Firm Act); MiFID II / MiFIR; EMIR; PRIIPs Regulation; AIFMD Art. 42 (NPPR); GwG (AML Act)",
      "categorisation_note": "Client categories follow Sec. 67 WpHG (MiFID II): eligible counterparties, per-se professional clients, elective professional clients and retail clients. The matrix below applies to cross-border activity by Contoso Bank PLC, London. Activity by Contoso Bank Europe PLC under its EU passport is not restricted by this matrix and is governed by document CBTI-EEA-2026-001.",
      "tax": "Dividend withholding tax of 26.375% (25% plus solidarity surcharge) applies at source; relief to treaty rates is available via relief-at-source or reclaim (see Group Tax country card TAX-DE-09). No financial transaction tax is currently in force. Fund investments fall within the scope of the German Investment Tax Act (InvStG)."
    },
    {
      "country": "Swiss Confederation",
      "iso": "CH",
      "doc_ref": "CBTI-CH-2026-008",
      "version": "2.3",
      "status": "Approved",
      "effective_date": "2026-08-16",
      "review_date": "2027-08-15",
      "supersedes": "CBTI-CH-2024-004 (v2.2)",
      "owner": "Legal - Cross-Border Trading Office, EMEA",
      "key_legislation": "FinSA / FIDLEG (Financial Services Act); FinIA (Financial Institutions Act); CISA (Collective Investment Schemes Act); FMIA / FinfraG (Market Infrastructure Act); Swiss Banking Act",
      "categorisation_note": "Client segmentation follows FinSA Art. 4: institutional clients, professional clients and retail (private) clients. Note the categories do NOT map one-to-one to MiFID II; opting out / opting in per FinSA Art. 5 must be documented. The matrix applies to cross-border activity by Contoso Bank PLC, London into Switzerland.",
      "tax": "Swiss withholding tax of 35% applies to Swiss-source dividends and certain interest; relief via reclaim under the applicable double tax treaty (see Group Tax country card TAX-CH-06). Swiss transfer stamp tax (Umsatzabgabe) of up to 0.15% (domestic) / 0.30% (foreign securities) may apply where a Swiss securities dealer is a party or intermediary to the transaction."
    }
  ],
