  "conditions": [
    {
      "country_iso": "DE",
      "doc_ref": "CBTI-DE-2026-011",
      "condition_ref": 1,
      "text": "Conducted by Contoso Bank PLC in reliance on the BaFin exemption order under Sec. 2(5) KWG (12 March 2021); available to institutional clients only and subject to the conditions of that order."
