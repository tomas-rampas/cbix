<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework, Nullable, ImplicitUsings, LangVersion and
       TreatWarningsAsErrors come from /Directory.Build.props. -->
  <PropertyGroup>
    <RootNamespace>Cbix.Core</RootNamespace>
    <AssemblyName>Cbix.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Provider-neutral AI abstractions only. Adding a provider package here would
         break the LLM-agnosticism constraint at its root; see /Directory.Packages.props. -->
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <!-- Logging abstractions, not a logging implementation: Core emits structured security events
         (ingest refusals) and leaves every sink choice to the host. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- Local PDF parsing for the ingest text layer (design 5.1). Offline and provider-neutral:
         the grounding corpus is the same under every provider profile. See the rationale on the
         PackageVersion entry in /Directory.Packages.props. -->
    <PackageReference Include="PdfPig" />
    <!-- Local page rasterisation (PDFium via SkiaSharp) for the generic-vision profile: PdfPig
         reads a PDF but cannot draw one. Offline and provider-neutral, same test as PdfPig above;
         see the rationale and the supply-chain evidence on the PackageVersion entry in
         /Directory.Packages.props. -->
    <PackageReference Include="PDFtoImage" />
    <!-- Named directly by the renderer: PDFtoImage's single-parse rendering API yields SKBitmap and
         PNG encoding goes through SKData. Transitive would compile identically; declaring it is how
         the version stays pinned in lockstep with PDFtoImage's native assets. -->
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

</Project>
